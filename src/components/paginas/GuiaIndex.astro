---
import Base from '../../layouts/Base.astro';
import { alternatesEstatico, urlArticulo, type Locale } from '../../lib/rutas';
import { guia } from '../../lib/datos';
import { t } from '../../i18n/strings';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
const alternates = alternatesEstatico('guia');
const metodo = guia.filter((a) => a.grupo === 'metodo');
const preguntas = guia.filter((a) => a.grupo === 'preguntas');
---

<Base
  locale={locale}
  title={`${s.guideTitle} — Fodmind`}
  description={s.guideText}
  canonical={alternates[locale]}
  alternates={alternates}
>
  <div class="entrada">
    <h1>{s.guideTitle}</h1>
    <p class="texto-muted" style="max-width:680px">{s.guideText}</p>
  </div>

  <section>
    <div class="rejilla-3" style="margin-top:14px">
      {metodo.map((art) => (
        <a class="tarjeta tarjeta-clicable" href={urlArticulo(locale, art.id)}>
          <h3>{art.title[locale]}</h3>
          <p class="pie-tarjeta">{art.summary[locale]}</p>
          <p class="pie-tarjeta" style="font-weight:700;color:var(--brand);margin-top:10px">{s.readMore} →</p>
        </a>
      ))}
    </div>
  </section>

  {preguntas.length > 0 && (
    <section>
      <h2 class="subrayado-seccion">{s.faqTitle}</h2>
      <div class="rejilla-3">
        {preguntas.map((art) => (
          <a class="tarjeta tarjeta-clicable" href={urlArticulo(locale, art.id)}>
            <h3>{art.title[locale]}</h3>
            <p class="pie-tarjeta">{art.summary[locale]}</p>
          </a>
        ))}
      </div>
    </section>
  )}

</Base>
