---
import Base from '../../layouts/Base.astro';
import TarjetaAlimento from '../../components/TarjetaAlimento.astro';
import { CAT_SLUG, urlLanding, urlAlimentos, urlCategoria, urlNivelCat, alternatesCategoria, type Locale } from '../../lib/rutas';
import { categoria } from '../../lib/datos';
import { catName, CAT_NAMES } from '../../i18n/categorias';
import { t } from '../../i18n/strings';
import { fmt, rellenar } from '../../lib/formatos';

interface Props {
  locale: Locale;
  catId: string;
}

const { locale, catId } = Astro.props;
const s = t(locale);
const cat = categoria(catId)!;
const nombre = catName(catId, locale);
const orden: Record<string, number> = { low: 0, moderate: 1, high: 2 };
const porNivel = ['low', 'moderate', 'high'].map((nivel) => ({
  nivel: nivel as 'low' | 'moderate' | 'high',
  alimentos: cat.alimentos
    .filter((f) => f.level === nivel)
    .sort((a, b) => a.names[locale].localeCompare(b.names[locale], locale)),
}));

const alternates = alternatesCategoria(catId);

const site = Astro.site ?? new URL('https://fodmind.com');
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Fodmind', item: new URL(urlLanding(locale), site).toString() },
    { '@type': 'ListItem', position: 2, name: s.foodsIndexTitle, item: new URL(urlAlimentos(locale), site).toString() },
    { '@type': 'ListItem', position: 3, name: nombre },
  ],
};
---

<Base
  locale={locale}
  title={rellenar(s.catMetaTitle, { cat: nombre.toLowerCase() })} 
  description={rellenar(s.catMetaDesc, { cat: nombre.toLowerCase() })}
  canonical={alternates[locale]}
  alternates={alternates}
  jsonld={breadcrumb}
>
  <nav class="migas">
    <a href={urlLanding(locale)}>Fodmind</a> ›
    <a href={urlAlimentos(locale)}>{s.foodsIndexTitle}</a> ›
    <span>{nombre}</span>
  </nav>

  <div class="entrada" style="padding-top:12px">
    <h1>{nombre}</h1>
    <p class="texto-muted">{rellenar(s.nFoods, { n: fmt(cat.alimentos.length, locale) })} · {s.foodsIndexText}</p>
  </div>

  {porNivel.map(
    (grupo) =>
      grupo.alimentos.length > 0 && (
        <section>
          <h2 class="subrayado-seccion">
            <a href={urlNivelCat(locale, grupo.nivel, catId)}>{s.levelNames[grupo.nivel]}</a>
            <span class="texto-muted" style="font-size:17px;font-weight:500">({fmt(grupo.alimentos.length, locale)})</span>
          </h2>
          <p class="texto-muted" style="margin-top:-6px">{s.levelDescriptions[grupo.nivel]}</p>
          <div class="rejilla-3">
            {grupo.alimentos.map((food) => <TarjetaAlimento food={food} locale={locale} />)}
          </div>
        </section>
      )
  )}

  <section>
    <h2 class="subrayado-seccion">{s.categoriesTitle}</h2>
    <div class="rejilla-categorias">
      {Object.keys(CAT_NAMES)
        .filter((id) => id !== catId)
        .map((id) => (
          <a class="tarjeta tarjeta-clicable" href={urlCategoria(locale, CAT_SLUG[id][locale])}>
            <h3>{catName(id, locale)}</h3>
          </a>
        ))}
    </div>
  </section>

</Base>
