---
import { t, enlaceAppStore, enlacePlay } from '../i18n/strings';
import type { Locale } from '../lib/rutas';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section class="cta-banda" id="descargar">
  <h2>Fodmind</h2>
  <p>{s.metaHomeDesc}</p>
  <div class="tiendas">
    <a class="tienda-boton" href={enlaceAppStore('web-banda')} rel="noopener">
      <span aria-hidden="true"></span>
      <span><small>{s.badgeApple}</small>App Store</span>
    </a>
    <a class="tienda-boton" href={enlacePlay('web-banda')} rel="noopener">
      <span aria-hidden="true">▶</span>
      <span><small>{s.badgePlay}</small>Google Play</span>
    </a>
  </div>
</section>
