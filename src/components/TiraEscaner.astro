---
/**
 * LA TIRA FIJA DE ABAJO, CON EL ESCÁNER EN MOVIMIENTO: cinco animaciones, una
 * por visitante, en todas las páginas y desde el primer segundo.
 *
 * Sustituye a la barra que salía al bajar (BarraApp, hasta el 25-sep-2026):
 * el láser sobre el paquete (a), el visor de la cámara (b), la cinta del súper
 * (c), el código de barras con la ración (d) y la lupa sobre la etiqueta (e).
 *
 * LO QUE DICE LO DECIDE lib/tira.ts con los alimentos que le pasa la página:
 * en la ficha del pan de trigo habla del pan de trigo, de su ración y de sus
 * sustitutos; en una categoría, de un alimento suyo; sin alimentos (portada,
 * índices) dice lo general. Aquí solo se pinta.
 *
 * ES UNA PRUEBA: cada visitante recibe una letra al azar, la guarda en
 * localStorage y la ve igual en todas las páginas. Los contadores de
 * Base.astro la cuentan por su `data-ct` («web-tira-a»…«web-tira-e») y
 * `node scripts/eventos.mjs` saca los clics por cada cien vistos de cada
 * letra. La X la cierra para el resto de la sesión.
 *
 * La letra se decide en un script que va ANTES del HTML, así el CSS ya sabe
 * cuál enseñar cuando pinta y no hay salto; sin JS no se ve ninguna. Los
 * resultados que rotan llevan su turno en una clase (t1, t2, t3) y no por
 * posición: con nth-of-type el visor (b) teñía el marco de un producto,
 * enseñaba el veredicto de otro y el nombre de un tercero.
 *
 * PANTALLAS: en móvil es una banda a todo lo ancho; por debajo de 400 px la
 * animación se encoge para que quepan el texto y el botón. Desde 700 px
 * (iPad, portátil) es una tarjeta flotante centrada y escalada con `zoom`,
 * que agranda animación, texto y botón a la vez. Con el móvil apaisado se
 * hace más baja. El hueco que deja al final de la página se mide en vivo.
 */
import { vistaTira } from '../lib/tira';
import type { Alimento } from '../lib/tipos';
import type { Nivel } from '../i18n/tira';
import { TIRA } from '../i18n/tira';
import { t } from '../i18n/strings';
import type { Locale } from '../lib/rutas';

interface Props {
  locale: Locale;
  /** El alimento de la página primero; los demás son los que rotan detrás. */
  alimentos?: Alimento[];
}

const { locale, alimentos } = Astro.props;
const s = t(locale);
const boton = TIRA[locale].boton;
const nivelTxt = TIRA[locale].nivel;
const v = vistaTira(locale, alimentos);
const COLOR: Record<Nivel, string> = { bajo: '#217242', medio: '#845C07', alto: '#AF3129' };
const FONDO: Record<Nivel, string> = { bajo: '#E4F3E9', medio: '#F7EDD6', alto: '#F9E4E1' };
const chip = (n: Nivel) => `color:${COLOR[n]};background:${FONDO[n]}`;
const turno = (i: number) => `t${i + 1}`;
// El icono del botón: el marco del visor con la línea del láser.
const ICONO =
  '<svg class="tira-ico" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8V5.5A1.5 1.5 0 0 1 5.5 4H8M16 4h2.5A1.5 1.5 0 0 1 20 5.5V8M20 16v2.5a1.5 1.5 0 0 1-1.5 1.5H16M8 20H5.5A1.5 1.5 0 0 1 4 18.5V16"/><path d="M7 12h10"/></svg>';
const primeraMarca = v.e.trozos.findIndex((x) => x.marca);
const cinta = [
  { forma: 'caja', nivel: 'alto' },
  { forma: 'bote', nivel: 'bajo' },
  { forma: 'botella', nivel: 'medio' },
  { forma: 'fruta', nivel: 'bajo' },
] as const;
const cintaDoble = [...cinta, ...cinta];
---

<script is:inline>
  (function () {
    var v = null;
    try {
      if (sessionStorage.getItem('tira') === 'no') return;
      v = localStorage.getItem('tira-v');
      if (!/^[a-e]$/.test(v || '')) {
        v = 'abcde'.charAt(Math.floor(Math.random() * 5));
        localStorage.setItem('tira-v', v);
      }
    } catch (e) {
      if (!v) v = 'abcde'.charAt(Math.floor(Math.random() * 5));
    }
    document.documentElement.setAttribute('data-tira', v);
  })();
</script>

<div class="tira tira-a" data-v="a">
  <div class="tira-cuerpo">
    <div class="tira-anim">
      <div class="ta-pack"><i class="ta-lbl c"></i><i class="ta-lbl"></i><i class="ta-lbl corta"></i><i class="ta-code"></i><i class="ta-flash"></i><i class="ta-laser"></i></div>
    </div>
    <div class="tira-txt">
      {v.nombre && <span class="tira-nombre">{v.nombre}</span>}
      <b class="tira-titulo">{v.titulo}</b>
      <div class="tira-ciclo">
        {v.a.filas.map((p, i) => (
          <div class={`tira-linea ta-res ${turno(i)}`}><i class="tira-chip" style={chip(p.nivel)}>{nivelTxt[p.nivel]}</i> {p.nombre}</div>
        ))}
      </div>
    </div>
    <a class="boton boton-primario" href="#descargar" data-descarga data-abrir data-ct="tira-a"><Fragment set:html={ICONO} /><span>{boton}</span></a>
    <button type="button" class="tira-x" aria-label={s.cerrar}>×</button>
  </div>
</div>

<div class="tira tira-b" data-v="b">
  <div class="tira-cuerpo">
    <div class="tira-anim">
      <div class="tb-vf">
        <div class="tb-lbl"><i class="t"></i><i></i><i class="m"></i><i class="code"></i></div>
        <div class="tb-esq"><i></i><i></i><i></i><i></i></div>
        {v.b.filas.map((p, i) => (
          <div class={`tb-esq col ${turno(i)}`} style={`--c:${COLOR[p.nivel]}`}><i></i><i></i><i></i><i></i></div>
        ))}
        <div class="tb-line"></div>
        {v.b.filas.map((p, i) => (
          <div class={`tb-badge ${turno(i)}`} style={chip(p.nivel)}>{nivelTxt[p.nivel]}</div>
        ))}
      </div>
    </div>
    <div class="tira-txt">
      {v.nombre && <span class="tira-nombre">{v.nombre}</span>}
      <b class="tira-titulo">{v.titulo}</b>
      <div class="tira-ciclo">
        {v.b.filas.map((p, i) => <div class={`tira-linea tb-nom ${turno(i)}`}>{p.racion && <b>{p.racion}</b>}{p.racion && ' · '}{p.nombre}</div>)}
      </div>
    </div>
    <a class="boton boton-primario" href="#descargar" data-descarga data-abrir data-ct="tira-b"><Fragment set:html={ICONO} /><span>{boton}</span></a>
    <button type="button" class="tira-x" aria-label={s.cerrar}>×</button>
  </div>
</div>

<div class="tira tira-c" data-v="c">
  <div class="tira-cuerpo">
    <div class="tira-anim">
      <div class="tc-banda">
        <div class="tc-suelo"></div>
        <div class="tc-track">
          {cintaDoble.map((p) => (
            <div class={`tc-p ${p.forma}`}><i class="cuerpo"></i><i class="eti"></i><i class="eti"></i><span class="tc-punto" style={`background:${COLOR[p.nivel]}`}></span></div>
          ))}
        </div>
        <div class="tc-clip"><div class="tc-track">
          {cintaDoble.map((p) => (
            <div class={`tc-p ${p.forma}`}><i class="cuerpo"></i><i class="eti"></i><i class="eti"></i><span class="tc-punto" style={`background:${COLOR[p.nivel]}`}></span></div>
          ))}
        </div></div>
        <div class="tc-arco"></div>
        <div class="tc-gate"></div>
      </div>
    </div>
    <div class="tira-txt">
      {v.nombre && <span class="tira-nombre">{v.nombre}</span>}
      <b class="tira-titulo">{v.titulo}</b>
      {v.c.nivel && <span class="tira-linea tc-veredicto"><i class="tira-chip" style={chip(v.c.nivel)}>{nivelTxt[v.c.nivel]}</i> {v.c.racion}</span>}
      {v.c.texto && <span class="tira-sub una">{v.c.texto}</span>}
    </div>
    <a class="boton boton-primario" href="#descargar" data-descarga data-abrir data-ct="tira-c"><Fragment set:html={ICONO} /><span>{boton}</span></a>
    <button type="button" class="tira-x" aria-label={s.cerrar}>×</button>
  </div>
</div>

<div class="tira tira-d" data-v="d">
  <div class="tira-cuerpo">
    <div class="tira-anim">
      <div class="td-code"></div>
      <div class="td-read"></div>
      <div class="td-beam"></div>
      <div class="td-beep">✓</div>
    </div>
    <div class="tira-txt">
      {v.nombre && <span class="tira-nombre">{v.nombre}</span>}
      <b class="tira-titulo">{v.titulo}</b>
      <div class="tira-ciclo">
        {v.d.filas.map((p, i) => (
          <div class={`tira-linea td-card ${turno(i)}`}><i class="tira-chip" style={chip(p.nivel)}>{nivelTxt[p.nivel]}</i> <b>{p.racion}</b> · {p.nombre}</div>
        ))}
      </div>
    </div>
    <a class="boton boton-primario" href="#descargar" data-descarga data-abrir data-ct="tira-d"><Fragment set:html={ICONO} /><span>{boton}</span></a>
    <button type="button" class="tira-x" aria-label={s.cerrar}>×</button>
  </div>
</div>

<div class="tira tira-e" data-v="e">
  <div class="tira-cuerpo">
    <div class="tira-anim">
      <div class="te-lista">
        <b>{v.e.etiqueta}</b>{v.e.trozos.map((x, i) => (x.marca ? <mark class={i > primeraMarca ? 'm2' : ''} style={`--mc:${COLOR[x.marca]};--mf:${FONDO[x.marca]}`}>{x.t}</mark> : x.t))}
      </div>
      <div class="te-lupa"></div>
      <div class={`te-num${v.e.num ? '' : ' ok'}`}>{v.e.num || '✓'}</div>
    </div>
    <div class="tira-txt">
      {v.nombre && <span class="tira-nombre">{v.nombre}</span>}
      <b class="tira-titulo">{v.titulo}</b>
      <span class="te-alt" style={`color:${COLOR[v.e.pieNivel]}`}>{v.e.pie}</span>
    </div>
    <a class="boton boton-primario" href="#descargar" data-descarga data-abrir data-ct="tira-e"><Fragment set:html={ICONO} /><span>{boton}</span></a>
    <button type="button" class="tira-x" aria-label={s.cerrar}>×</button>
  </div>
</div>

<script is:inline>
  (function () {
    var raiz = document.documentElement;
    var v = raiz.getAttribute('data-tira');
    var tira = v && document.querySelector('.tira[data-v="' + v + '"]');
    if (!tira) return;
    // El hueco del final de la página es lo que la tira tapa, medido: cambia
    // con el ancho, con el zoom de la tarjeta y con la barra del navegador.
    var ajusta = function () {
      if (!raiz.hasAttribute('data-tira')) return;
      var r = tira.getBoundingClientRect();
      if (r.height) raiz.style.setProperty('--tira-alto', Math.ceil(window.innerHeight - r.top + 12) + 'px');
    };
    ajusta();
    window.addEventListener('resize', ajusta);
    if ('ResizeObserver' in window) new ResizeObserver(ajusta).observe(tira);
    // TODA LA TIRA ES EL BOTÓN, menos la X. El toque se reenvía al enlace de
    // verdad con .click(): así pasa por los mismos oyentes de Base.astro (el
    // que pone la tienda o el intent de Android y el contador de clics) y
    // cuenta una sola vez. Dentro del gesto del usuario, el navegador deja
    // abrir la tienda o la app igual que con el botón.
    var boton = tira.querySelector('a[data-ct]');
    tira.addEventListener('click', function (e) {
      if (e.target.closest && e.target.closest('a, .tira-x')) return;
      boton.click();
    });
    tira.querySelector('.tira-x').addEventListener('click', function () {
      raiz.removeAttribute('data-tira');
      raiz.style.removeProperty('--tira-alto');
      try { sessionStorage.setItem('tira', 'no'); } catch (err) { /* sin almacenamiento, sin memoria */ }
    });
  })();
</script>

<style is:global>
  /* ---------- la tira del escáner ---------- */
  .tira { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; display: none; cursor: pointer; -webkit-tap-highlight-color: transparent; user-select: none; -webkit-user-select: none; padding: 12px 12px calc(14px + env(safe-area-inset-bottom)); background: var(--bg); border-top: 1px solid var(--borde); box-shadow: 0 -8px 22px rgba(0, 0, 0, 0.09); }
  html[data-tira='a'] .tira[data-v='a'], html[data-tira='b'] .tira[data-v='b'], html[data-tira='c'] .tira[data-v='c'], html[data-tira='d'] .tira[data-v='d'], html[data-tira='e'] .tira[data-v='e'] { display: block; }
  html[data-tira] body { padding-bottom: var(--tira-alto, 140px); }
  .tira-cuerpo { position: relative; display: flex; align-items: center; gap: 12px; max-width: 600px; margin: 0 auto; }
  .tira-anim { position: relative; flex: none; }
  .tira-txt { flex: 1; min-width: 0; }
  .tira-titulo { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 19px; font-weight: 800; line-height: 1.12; letter-spacing: -0.01em; overflow-wrap: anywhere; }
  .tira-sub { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 12px; color: var(--muted); margin-top: 3px; line-height: 1.25; }
  .tira-sub.una { -webkit-line-clamp: 1; }
  .tira-ciclo { position: relative; height: 24px; margin-top: 6px; }
  /* La línea de debajo del titular: una sola, con el chip y lo que no quepa en puntos suspensivos. */
  .tira-linea { display: block; font-size: 12.5px; line-height: 24px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tira-linea b { font-weight: 800; }
  .tc-veredicto { margin-top: 6px; }
  .tira-chip { display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: middle; font-size: 11px; font-weight: 800; padding: 3px 8px; border-radius: 999px; letter-spacing: 0.02em; font-style: normal; }
  /* EL BOTÓN, grande: en móvil es un bloque alto con el icono encima, por
     encima de los 44 px de zona táctil que piden Apple y Google; en iPad y
     ordenador va en fila. */
  .tira .boton { flex: none; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; min-width: 94px; min-height: 64px; padding: 9px 14px; border-radius: 16px; font-size: 15px; font-weight: 800; line-height: 1.1; white-space: nowrap; box-shadow: 0 4px 12px rgba(47, 99, 55, 0.28); transition: transform 0.12s ease, background 0.12s ease; }
  .tira-ico { width: 24px; height: 24px; flex: none; }
  .tira:hover .boton-primario { background: var(--brand-oscuro); }
  .tira:active { background: #f3eee0; }
  .tira:active .boton { transform: scale(0.97); }
  .tira-x { position: absolute; top: -10px; right: -6px; border: 0; background: transparent; color: var(--muted); font-size: 22px; line-height: 1; padding: 4px 6px; cursor: pointer; }
  /* Los turnos de lo que rota: 0, 3 y 6 s de un ciclo de 9. */
  .tira .t2 { animation-delay: 3s; }
  .tira .t3 { animation-delay: 6s; }

  /* a · el láser sobre el paquete */
  .tira-a .tira-anim { width: 96px; height: 92px; }
  .ta-pack { position: absolute; left: 14px; top: 4px; width: 66px; height: 84px; border-radius: 9px; background: #fff; border: 1.5px solid var(--borde); box-shadow: 0 3px 8px rgba(0, 0, 0, 0.07); overflow: hidden; }
  .ta-lbl { display: block; height: 6px; border-radius: 3px; background: #e7e2d3; margin: 10px 10px 0; }
  .ta-lbl.c { width: 28px; background: #cfc9b6; }
  .ta-lbl.corta { width: 24px; }
  .ta-code { position: absolute; bottom: 9px; left: 10px; right: 10px; height: 24px; background: repeating-linear-gradient(90deg, #26251f 0 2px, transparent 2px 4px, #26251f 4px 5px, transparent 5px 8px, #26251f 8px 11px, transparent 11px 13px); }
  .ta-flash { position: absolute; inset: 0; background: rgba(58, 125, 68, 0.22); opacity: 0; animation: ta-flash 3s infinite; }
  .ta-laser { position: absolute; left: 6px; right: 6px; height: 2px; background: var(--brand); box-shadow: 0 0 10px 3px rgba(58, 125, 68, 0.55); animation: ta-laser 3s ease-in-out infinite; }
  @keyframes ta-laser { 0% { top: 6px; opacity: 0; } 8% { opacity: 1; } 45% { top: 80px; opacity: 1; } 56% { top: 80px; opacity: 0; } 100% { top: 6px; opacity: 0; } }
  @keyframes ta-flash { 0%, 44% { opacity: 0; } 48%, 60% { opacity: 1; } 70%, 100% { opacity: 0; } }
  .ta-res { position: absolute; left: 0; right: 0; top: 0; opacity: 0; transform: translateY(8px); animation: ta-res 9s infinite; }
  @keyframes ta-res { 0%, 15% { opacity: 0; transform: translateY(8px); } 19%, 31% { opacity: 1; transform: none; } 34%, 100% { opacity: 0; transform: translateY(-6px); } }

  /* b · el visor de la cámara */
  .tira-b .tira-anim { width: 112px; height: 84px; }
  .tb-vf { position: absolute; inset: 0; background: #1c1b18; border-radius: 12px; overflow: hidden; }
  .tb-lbl { position: absolute; left: 18px; top: 14px; width: 76px; height: 56px; background: #fff; border-radius: 7px; padding: 8px; animation: tb-slide 3s infinite; }
  .tb-lbl i { display: block; height: 5px; border-radius: 3px; background: #e7e2d3; margin-bottom: 6px; }
  .tb-lbl i.t { width: 30px; background: #cfc9b6; }
  .tb-lbl i.m { width: 40px; }
  .tb-lbl i.code { height: 12px; margin-top: 7px; border-radius: 0; background: repeating-linear-gradient(90deg, #26251f 0 2px, transparent 2px 4px, #26251f 4px 5px, transparent 5px 7px); }
  @keyframes tb-slide { 0% { transform: translateX(120px); } 14%, 82% { transform: none; } 96%, 100% { transform: translateX(-130px); } }
  .tb-line { position: absolute; left: 12px; right: 12px; height: 2px; background: #7fd18b; box-shadow: 0 0 8px 2px rgba(127, 209, 139, 0.6); animation: tb-line 3s infinite; }
  @keyframes tb-line { 0%, 16% { top: 12px; opacity: 0; } 20% { opacity: 1; } 50% { top: 70px; opacity: 1; } 54%, 100% { top: 70px; opacity: 0; } }
  .tb-esq { position: absolute; inset: 6px; pointer-events: none; }
  .tb-esq i { position: absolute; width: 16px; height: 16px; border: 3px solid #fff; border-radius: 3px; }
  .tb-esq i:nth-child(1) { left: 0; top: 0; border-right: 0; border-bottom: 0; }
  .tb-esq i:nth-child(2) { right: 0; top: 0; border-left: 0; border-bottom: 0; }
  .tb-esq i:nth-child(3) { left: 0; bottom: 0; border-right: 0; border-top: 0; }
  .tb-esq i:nth-child(4) { right: 0; bottom: 0; border-left: 0; border-top: 0; }
  .tb-esq.col { opacity: 0; animation: tb-col 9s infinite; }
  .tb-esq.col i { border-color: var(--c); }
  @keyframes tb-col { 0%, 17% { opacity: 0; } 19%, 27% { opacity: 1; } 30%, 100% { opacity: 0; } }
  .tb-badge { position: absolute; left: 50%; top: 50%; max-width: 96px; overflow: hidden; text-overflow: ellipsis; transform: translate(-50%, -50%) scale(0.6); opacity: 0; font-size: 14px; font-weight: 900; padding: 5px 11px; border-radius: 999px; animation: tb-badge 9s infinite; letter-spacing: 0.03em; white-space: nowrap; }
  @keyframes tb-badge { 0%, 17% { opacity: 0; transform: translate(-50%, -50%) scale(0.6); } 19.5% { opacity: 1; transform: translate(-50%, -50%) scale(1.05); } 21% { transform: translate(-50%, -50%) scale(1); } 27% { opacity: 1; } 30%, 100% { opacity: 0; transform: translate(-50%, -50%) scale(0.8); } }
  .tb-nom { position: absolute; left: 0; right: 0; top: 0; opacity: 0; animation: tb-col 9s infinite; }

  /* c · la cinta del súper */
  .tira-c .tira-anim { width: 130px; height: 72px; }
  .tc-banda { position: absolute; inset: 0; overflow: hidden; border-radius: 10px; background: #f1ede0; }
  .tc-suelo { position: absolute; left: 0; right: 0; bottom: 0; height: 10px; background: repeating-linear-gradient(90deg, #d8d2bd 0 10px, #e4dfcc 10px 20px); animation: tc-suelo 1s linear infinite; }
  @keyframes tc-suelo { to { background-position: -20px 0; } }
  .tc-track { position: absolute; left: 0; bottom: 10px; display: flex; gap: 22px; padding-left: 8px; animation: tc-move 8s linear infinite; }
  @keyframes tc-move { to { transform: translateX(-244px); } }
  .tc-p { position: relative; width: 39px; height: 46px; flex: none; }
  .tc-p .cuerpo { position: absolute; bottom: 0; left: 4px; right: 4px; top: 6px; background: #fff; border: 1.5px solid var(--borde); border-radius: 7px; }
  .tc-p.bote .cuerpo { border-radius: 9px 9px 7px 7px; top: 10px; }
  .tc-p.bote::before { content: ''; position: absolute; left: 10px; right: 10px; top: 4px; height: 8px; background: #cfc9b6; border-radius: 3px; }
  .tc-p.botella .cuerpo { left: 9px; right: 9px; top: 12px; border-radius: 8px 8px 6px 6px; }
  .tc-p.botella::before { content: ''; position: absolute; left: 15px; right: 15px; top: 2px; height: 12px; background: #d9d3c0; border-radius: 3px 3px 0 0; }
  .tc-p.botella .eti { display: none; }
  .tc-p.fruta .cuerpo { border-radius: 50%; top: 10px; left: 3px; right: 3px; }
  .tc-p.fruta::before { content: ''; position: absolute; left: 50%; top: 4px; width: 3px; height: 10px; background: var(--brand); border-radius: 2px; }
  .tc-p.fruta .eti { display: none; }
  .tc-p .eti { position: absolute; left: 10px; right: 10px; top: 20px; height: 4px; background: #e7e2d3; border-radius: 2px; }
