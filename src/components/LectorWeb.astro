---
/**
 * EL LECTOR EN LA WEB: probar la app antes de instalarla.
 *
 * Quien llega a una ficha desde el buscador viene con una pregunta y se va
 * contestado; el que se convierte es el que ve la app funcionar. Aquí pega
 * una lista de ingredientes y ve rodeadas las palabras FODMAP, como en la
 * app, y debajo lo que la web no puede hacer y la app sí: leerla con la
 * cámara en la tienda, pesar la ración, lo que uno tolera. Todo en el
 * navegador, sin servidor: las palabras están en lib/lector-palabras.mjs.
 *
 * No afirma que una lista esté limpia. Sin hallazgos dice «ninguna palabra
 * FODMAP clara», que es verdad, y no «apto», que no lo sabe.
 *
 * EL SCRIPT NO VA EN LÍNEA. Astro lo empaqueta en un fichero con hash que se
 * baja una vez y vale para las 11.479 páginas; en línea, el diccionario
 * pesaba 4 KB comprimidos en CADA ficha, el doble de lo que pesaba la ficha
 * entera. Los textos del idioma van en atributos data- del propio bloque.
 */
import { t } from '../i18n/strings';
import type { Locale } from '../lib/rutas';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = t(locale);
---

<section
  class="lector-web"
  id="lector"
  data-una={s.lectorUna}
  data-varias={s.lectorVarias}
  data-ninguna={s.lectorNinguna}
  data-familias={JSON.stringify(s.familias)}
>
  <h2 class="subrayado-seccion">{s.lectorTitulo}</h2>
  <textarea class="lector-texto" rows="4" placeholder={s.lectorPlaceholder} aria-label={s.lectorTitulo}></textarea>
  <button type="button" class="boton boton-primario lector-boton">{s.lectorBoton}</button>
  <div class="lector-resultado" hidden>
    <p class="lector-cuenta" role="status"></p>
    <p class="lector-marcado"></p>
    <div class="lector-pildoras"></div>
    <p class="lector-nota">{s.lectorNota}</p>
    <a class="boton boton-primario" href="#descargar" data-descarga data-abrir data-ct="lector">{s.ctaEscanear}</a>
    <p class="lector-aviso">{s.lectorAviso}</p>
  </div>
</section>

<script>
  import { lee, compila } from '../lib/lector-palabras.mjs';

  const raiz = document.getElementById('lector');
  // Los patrones usan lookbehind, que Safari no tuvo hasta la 16.4 (2023): en
  // un navegador que no lo entienda, el lector se esconde en vez de quedarse
  // con un boton que no hace nada.
  let soporta = true;
  try { new RegExp('(?<!a)b', 'u'); } catch { soporta = false; }
  if (raiz && !soporta) raiz.hidden = true;
  if (raiz && soporta) {
    const texto = raiz.querySelector<HTMLTextAreaElement>('.lector-texto')!;
    const boton = raiz.querySelector<HTMLButtonElement>('.lector-boton')!;
    const resultado = raiz.querySelector<HTMLElement>('.lector-resultado')!;
    const cuenta = raiz.querySelector<HTMLElement>('.lector-cuenta')!;
    const marcado = raiz.querySelector<HTMLElement>('.lector-marcado')!;
    const pildoras = raiz.querySelector<HTMLElement>('.lector-pildoras')!;
    const familias: Record<string, string> = JSON.parse(raiz.dataset.familias || '{}');
    let reglas: ReturnType<typeof compila> | null = null;
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);

    const leer = () => {
      const t = (texto.value || '').replace(/\s+/g, ' ').trim();
      if (!t) return;
      // Las expresiones se compilan la primera vez que hacen falta, no al cargar
      // la ficha: la mayoría de las visitas no usan el lector.
      reglas = reglas || compila();
      const tramos = lee(t, reglas);
      let html = '';
      let pos = 0;
      for (const tr of tramos) {
        html += `${esc(t.slice(pos, tr.a))}<mark class="lector-palabra">${esc(t.slice(tr.a, tr.b))}</mark>`;
        pos = tr.b;
      }
      marcado.innerHTML = html + esc(t.slice(pos));
      const vistas = new Set<string>();
      pildoras.innerHTML = tramos
        .filter((tr) => {
          const k = tr.palabra.toLowerCase();
          if (vistas.has(k)) return false;
          vistas.add(k);
          return true;
        })
        .map((tr) => `<span class="lector-pildora">${esc(tr.palabra.toLowerCase())} <small>${esc(familias[tr.familia] || tr.familia)}</small></span>`)
        .join('');
      const n = vistas.size;
      cuenta.textContent = n === 0 ? raiz.dataset.ninguna! : n === 1 ? raiz.dataset.una! : raiz.dataset.varias!.replace('{n}', String(n));
      cuenta.classList.toggle('lector-cuenta-roja', n > 0);
      resultado.hidden = false;
    };
    boton.addEventListener('click', leer);
    texto.addEventListener('keydown', (e) => { if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) leer(); });
  }
</script>
