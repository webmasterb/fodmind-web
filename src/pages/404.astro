---
import Base from '../layouts/Base.astro';
import { alternatesEstatico, urlLanding, type Locale } from '../lib/rutas';
import { t } from '../i18n/strings';

const locale = 'es' as Locale;
const s = t(locale);
const alternates = alternatesEstatico('landing');
---

<Base
  locale={locale}
  title="404 — Fodmind"
  description={s.metaHomeDesc}
  canonical="/404"
  alternates={alternates}
  noindex={true}
>
  <div class="entrada" style="text-align:center;padding:80px 0">
    <p style="font-size:64px;margin:0">🥬</p>
    <h1>404</h1>
    <p class="texto-muted">{s.foodsIndexText}</p>
    <p><a class="boton boton-primario" href={urlLanding(locale)}>Fodmind</a></p>
  </div>
</Base>
