---
/**
 * EL ENLACE DE LA BIO DE TIKTOK: fodmind.com/tiktok.
 *
 * La bio no puede llevar dos enlaces ni parametros raros, y el trafico que llega
 * por ella era indistinguible del de Google en el informe de App Store Connect:
 * las dos entran como «Web Referrer» desde fodmind.com. Esta pagina resuelve
 * eso sin SDK: mide la visita (Cloudflare, como todas), y salta a la tienda que
 * toca con el parametro de campana de cada una.
 *
 *   iPhone/iPad -> App Store con pt/ct: App Store Connect lo separa en
 *                  Analytics > Campaigns bajo «tiktok» (desde 5 instalaciones)
 *   Android     -> Google Play con referrer utm_source=tiktok: Play Console lo
 *                  separa en «adquisicion por UTM»
 *   escritorio  -> se queda aqui, con los dos botones
 *
 * El enlace de campana lo genero App Store Connect el 16-sep-2026 (pt es el
 * id de proveedor de la cuenta; ct la campana). noindex: no es una pagina
 * para el buscador, es una puerta.
 */
import Base from '../layouts/Base.astro';
import { enlaceAppStore, enlacePlay } from '../i18n/strings';
import { LOCALES, type Locale } from '../lib/rutas';

const CAMPANA_APPLE = enlaceAppStore('tiktok');
const CAMPANA_PLAY = enlacePlay('tiktok', 'tiktok', 'bio');
const alternates = Object.fromEntries(LOCALES.map((l) => [l, '/tiktok/'])) as Record<Locale, string>;
---

<Base
  locale="en"
  title="Fodmind — get the app"
  description="Scan any pack and see which FODMAP words are on the back, and how much of it fits your portion."
  canonical="/tiktok/"
  alternates={alternates}
  noindex
>
  <section class="puerta">
    <p class="puerta-hola">Seen a pack in one of our videos?</p>
    <h1>Scan it with Fodmind</h1>
    <p>Which FODMAP words are on the back, and how much of it fits your portion. Taking you to the store…</p>
    <div class="tiendas">
      <a class="tienda-boton" href={CAMPANA_APPLE} rel="noopener" data-tienda="apple">
        <span aria-hidden="true"></span>
        <span><small>Download on the</small>App Store</span>
      </a>
      <a class="tienda-boton" href={CAMPANA_PLAY} rel="noopener" data-tienda="play">
        <span aria-hidden="true">▶</span>
        <span><small>Get it on</small>Google Play</span>
      </a>
    </div>
    <p class="puerta-nota">Or keep reading: <a href={CAMPANA_APPLE} rel="noopener">App Store</a> · <a href={CAMPANA_PLAY} rel="noopener">Google Play</a> · <a href="/">fodmind.com</a></p>
  </section>
</Base>

<script is:inline define:vars={{ apple: CAMPANA_APPLE, play: CAMPANA_PLAY }}>
  // El salto va despues de que el beacon de Cloudflare haya podido contar la
  // visita: medio segundo, que en el movil ni se nota.
  const ua = navigator.userAgent || '';
  const esApple = /iPhone|iPad|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const esAndroid = /Android/.test(ua);
  const destino = esApple ? apple : esAndroid ? play : null;
  if (destino) setTimeout(() => window.location.replace(destino), 500);
</script>

<style>
  .puerta { text-align: center; padding: 3rem 0 2rem; }
  .puerta-hola { font-size: 1.1rem; opacity: 0.8; margin: 0 0 0.5rem; }
  .puerta h1 { margin: 0 0 0.75rem; }
  .puerta .tiendas { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; margin: 1.5rem 0; }
  .puerta-nota { font-size: 0.9rem; opacity: 0.7; }
</style>
