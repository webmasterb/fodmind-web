---
import { LOCALES, LOCALE_RAIZ, CAT_SLUG, SEG, base, type Locale } from '../lib/rutas';
import { NIVELES, NIVEL_SLUG } from '../i18n/niveles';
import { guiaSlug } from '../i18n/guia-slugs';
import { foods, guia, CATEGORIAS } from '../lib/datos';
import { getCollection } from 'astro:content';
import Landing from '../components/paginas/Landing.astro';
import AlimentosIndex from '../components/paginas/AlimentosIndex.astro';
import Categoria from '../components/paginas/Categoria.astro';
import Alimento from '../components/paginas/Alimento.astro';
import GuiaIndex from '../components/paginas/GuiaIndex.astro';
import Articulo from '../components/paginas/Articulo.astro';
import BlogIndex from '../components/paginas/BlogIndex.astro';
import Post from '../components/paginas/Post.astro';
import Legal from '../components/paginas/Legal.astro';
import Fuentes from '../components/paginas/Fuentes.astro';
import Nivel from '../components/paginas/Nivel.astro';

export async function getStaticPaths() {
  const rutas: { params: { slug?: string }; props: Record<string, unknown> }[] = [];
  const prefijo = (l: Locale) => (l === LOCALE_RAIZ ? [] : [l]);

  for (const locale of LOCALES) {
    const pref = prefijo(locale);

    if (locale !== LOCALE_RAIZ) {
      rutas.push({ params: { slug: locale }, props: { kind: 'landing', locale } });
    }

    rutas.push({
      params: { slug: [...pref, SEG.alimentos[locale]].join('/') },
      props: { kind: 'alimentos', locale },
    });

    for (const cat of CATEGORIAS) {
      rutas.push({
        params: { slug: [...pref, SEG.alimentos[locale], CAT_SLUG[cat.id][locale]].join('/') },
        props: { kind: 'categoria', locale, catId: cat.id },
      });
    }

    // Las listas por nivel y sus cortes por categoría: la búsqueda genérica
    // («low FODMAP foods») no tenía ninguna página en todo el sitio.
    for (const nivel of NIVELES) {
      rutas.push({
        params: { slug: [...pref, SEG.alimentos[locale], NIVEL_SLUG[nivel][locale]].join('/') },
        props: { kind: 'nivel', locale, nivel },
      });
      for (const cat of CATEGORIAS) {
        if (!cat.alimentos.some((f) => f.level === nivel)) continue;
        rutas.push({
          params: {
            slug: [...pref, SEG.alimentos[locale], NIVEL_SLUG[nivel][locale], CAT_SLUG[cat.id][locale]].join('/'),
          },
          props: { kind: 'nivel', locale, nivel, catId: cat.id },
        });
      }
    }

    for (const food of foods) {
      rutas.push({
        params: { slug: [...pref, SEG.alimentos[locale], food.slug[locale]].join('/') },
        props: { kind: 'alimento', locale, food },
      });
    }

    rutas.push({
      params: { slug: [...pref, SEG.guia[locale]].join('/') },
      props: { kind: 'guia', locale },
    });

    for (const art of guia) {
      rutas.push({
        params: { slug: [...pref, SEG.guia[locale], guiaSlug(art.id, locale)].join('/') },
        props: { kind: 'articulo', locale, articuloId: art.id },
      });
    }

    rutas.push({
      params: { slug: [...pref, SEG.blog[locale]].join('/') },
      props: { kind: 'blog', locale },
    });

    rutas.push({
      params: { slug: [...pref, SEG.fuentes[locale]].join('/') },
      props: { kind: 'fuentes', locale },
    });

    rutas.push({
      params: { slug: [...pref, SEG.privacidad[locale]].join('/') },
      props: { kind: 'privacidad', locale },
    });
    rutas.push({
      params: { slug: [...pref, SEG.terminos[locale]].join('/') },
      props: { kind: 'terminos', locale },
    });
  }

  const posts = await getCollection('blog');
  // El fichero identifica el post; el slug de la URL sale del frontmatter y
  // está traducido, así que los alternates se arman con el de cada idioma.
  const slugPorPost = new Map<string, Record<string, string>>();
  for (const entrada of posts) {
    const [dir, id] = entrada.id.split('/');
    if (!LOCALES.includes(dir as Locale)) continue;
    const yaVistos = slugPorPost.get(id) ?? {};
    yaVistos[dir] = entrada.data.urlSlug;
    slugPorPost.set(id, yaVistos);
  }
  for (const entrada of posts) {
    const [dir, id] = entrada.id.split('/');
    const locale = dir as Locale;
    if (!LOCALES.includes(locale)) continue;
    const pref = prefijo(locale);
    const slugs = slugPorPost.get(id)!;
    const alternatesPost = Object.fromEntries(
      LOCALES.filter((l) => slugs[l]).map((l) => [l, `${base(l)}/${SEG.blog[l]}/${slugs[l]}/`])
    ) as Record<Locale, string>;
    rutas.push({
      params: { slug: [...pref, SEG.blog[locale], entrada.data.urlSlug].join('/') },
      props: { kind: 'post', locale, entrada, alternatesPost },
    });
  }

  return rutas;
}

interface Props {
  kind: string;
  locale: Locale;
  nivel?: 'low' | 'moderate' | 'high';
  catId?: string;
  food?: unknown;
  articuloId?: string;
  entrada?: unknown;
  alternatesPost?: Record<Locale, string>;
}

const props = Astro.props as Props;
const { kind, locale } = props;
---

{kind === 'landing' && <Landing locale={locale} />}
{kind === 'alimentos' && <AlimentosIndex locale={locale} />}
{kind === 'categoria' && <Categoria locale={locale} catId={props.catId!} />}
{kind === 'nivel' && <Nivel locale={locale} nivel={props.nivel!} catId={props.catId} />}
{kind === 'alimento' && <Alimento locale={locale} food={props.food as never} />}
{kind === 'guia' && <GuiaIndex locale={locale} />}
{kind === 'articulo' && <Articulo locale={locale} articuloId={props.articuloId!} />}
{kind === 'blog' && <BlogIndex locale={locale} />}
{kind === 'post' && <Post locale={locale} entrada={props.entrada as never} alternatesPost={props.alternatesPost!} />}
{kind === 'fuentes' && <Fuentes locale={locale} />}
{kind === 'privacidad' && <Legal locale={locale} cual="privacidad" />}
{kind === 'terminos' && <Legal locale={locale} cual="terminos" />}
