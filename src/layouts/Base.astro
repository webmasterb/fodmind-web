---
import { LOCALES, LOCALE_TAG, LOCALE_RAIZ, urlLanding, urlAlimentos, urlGuia, urlBlog, urlFuentes, urlLegal, type Locale } from '../lib/rutas';
import { t, APP_ID, APP_STORE_URL, PLAY_STORE_URL } from '../i18n/strings';
import { texto } from '../lib/datos';
import CtaApp from '../components/CtaApp.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonical: string;
  alternates: Record<Locale, string>;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { locale, title, description, canonical, alternates, jsonld, noindex } = Astro.props;
const s = t(locale);
const site = Astro.site ?? new URL('https://fodmind.com');
const abs = (ruta: string) => new URL(ruta, site).toString();
const jsonldFinal = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];

/** Open Graph pide idioma_PAÍS, que no es el mismo formato que hreflang. */
const OG_LOCALE: Record<Locale, string> = {
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  de: 'de_DE',
  it: 'it_IT',
  pt: 'pt_PT',
};

const nav = [
  { href: urlAlimentos(locale), label: s.navAlimentos },
  { href: urlGuia(locale), label: s.navGuia },
  { href: urlBlog(locale), label: s.navBlog },
];
---

<!doctype html>
<html lang={LOCALE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(canonical)} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_TAG[l]} href={abs(alternates[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(alternates[LOCALE_RAIZ])} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fodmind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(canonical)} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs('/og.png')} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#faf7ef" />
    {jsonldFinal.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {/*
      LA BARRA NATIVA DE LA APP STORE, y conviene saber para qué NO sirve.

      Safari en iOS pinta arriba una barra con el icono de la app, su nota y un
      botón de instalar. Es lo más parecido que existe a «abrir la ficha lista
      para descargar», y no cuesta más que esta línea.

      Lo que NO hace: no aparece en el navegador integrado de otras apps
      —TikTok, Instagram y Facebook usan su propio WKWebView— ni en Chrome de
      iOS. Solo Safari y Safari View Controller, según respuesta de un ingeniero
      de Apple en sus foros. Así que esto sirve al tráfico del buscador, que
      aterriza en las 1.843 fichas, y NO al de las redes.

      Sin `app-argument`: la app no consta que lea URLs de entrada, y un
      argumento que se ignora es código muerto.

      OJO CON LOS COMENTARIOS AQUÍ. En Astro, `<!-- -->` se sirve y `{ / * * / }`
      no. Esta explicación en HTML engordaba cada página 1.133 bytes COMPRIMIDOS
      —un 30 % sobre 3.811— y se multiplicaba por 11.479 páginas.
    */}
    <meta name="apple-itunes-app" content={`app-id=${APP_ID}`} />
    {/*
      EL SALTO A LA TIENDA. Los botones de descarga apuntan al ancla de la banda
      de la propia página; con JS y en un móvil van directos a su tienda, que es
      un toque menos para quien entra con el teléfono en la mano. Sin JS sigue
      funcionando el ancla, y por eso el href es ese y no la tienda.

      TRES COSAS QUE COSTARON UNA REVISIÓN:

      1. querySelectorAll, no querySelector. Con el singular solo se arreglaba
         el PRIMER botón del DOM —el de la cabecera— y el del hero seguía
         desplazando la página. Ojo al tocarlo: un NodeList vacío es truthy, así
         que un `if (!lista) return` aquí no protegería de nada.

      2. iPadOS manda cadena de agente de Macintosh desde la 13, así que /iPad/
         no casa en un iPad. Se mira también maxTouchPoints; la app soporta iPad.

      3. Va en el head y además escucha el clic. El botón de la cabecera está en
         los primeros 3.500 bytes y este script estaba al final del documento:
         entre medias hay una ventana en la que un toque se iba al ancla. El
         oyente en fase de captura la cierra pase lo que pase.

      Y no se toca `rel`: sin target="_blank", noopener no hace nada, y
      noreferrer borraría la cabecera Referer y con ella el informe de referentes
      web de App Store Connect, que es la única atribución gratis que hay.
    */}
    <script is:inline define:vars={{ IOS: APP_STORE_URL, ANDROID: PLAY_STORE_URL }}>
      (function () {
        var ua = navigator.userAgent || '';
        var esIOS = /iPad|iPhone|iPod/.test(ua)
          || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var destino = esIOS ? IOS : /Android/.test(ua) ? ANDROID : null;
        if (!destino) return;
        var pinta = function () {
          var l = document.querySelectorAll('[data-descarga]');
          for (var i = 0; i < l.length; i += 1) l[i].setAttribute('href', destino);
        };
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('[data-descarga]');
          if (a) a.setAttribute('href', destino);
        }, true);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', pinta);
        else pinta();
      })();
    </script>
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor barra">
        <a class="logo" href={urlLanding(locale)}>
          <span aria-hidden="true">🌿</span> <span class="logo-marca">Fodmind</span>
        </a>
        <nav class="nav" aria-label="principal">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="boton boton-primario" href="#descargar" data-descarga>{s.ctaApp}</a>
      </div>
    </header>

    <main>
      <div class="contenedor">
        <slot />
        <CtaApp locale={locale} />
      </div>
    </main>

    <footer class="pie">
      <div class="contenedor pie-rejilla">
        <div class="pie-sobre">
          <p class="pie-marca">🌿 Fodmind</p>
          <p class="pie-nota">{s.footerDisclaimer}</p>
          <p class="pie-nota">{s.footerSources}</p>
        </div>
        <div>
          <p class="pie-titulo">{s.ctaApp}</p>
          <a href={APP_STORE_URL} rel="noopener">App Store</a>
          <a href={PLAY_STORE_URL} rel="noopener">Google Play</a>
        </div>
        <div>
          <p class="pie-titulo">Legal</p>
          <a href={urlFuentes(locale)}>{texto('sourcesTitle', locale)}</a>
          <a href={urlLegal(locale, 'privacidad')}>{s.privacyTitle}</a>
          <a href={urlLegal(locale, 'terminos')}>{s.termsTitle}</a>
          <p class="pie-nota">© 2026 Fodmind</p>
        </div>
        <div>
          <p class="pie-titulo">{s.langSwitch}</p>
          <div class="pie-idiomas">
            {LOCALES.map((l) => (
              <a href={alternates[l]} hreflang={LOCALE_TAG[l]}>{l.toUpperCase()}</a>
            ))}
          </div>
        </div>
      </div>
    </footer>
    <!--
      Medición de visitas. La política de privacidad ya decía «las visitas se
      miden de forma anónima y agregada con Cloudflare Web Analytics» y el
      script no estaba en ninguna página: la web afirmaba algo que no pasaba.
      Sin cookies y sin datos personales, así que no pide consentimiento.
    -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "52da165e457a405bb28a45a1a23fe3cb"}'
    ></script>
  </body>
</html>
