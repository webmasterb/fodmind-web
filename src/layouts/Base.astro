---
import { LOCALES, LOCALE_TAG, LOCALE_RAIZ, urlLanding, urlAlimentos, urlGuia, urlBlog, urlFuentes, urlLegal, urlEscaner, type Locale } from '../lib/rutas';
import { t, APP_ID, APPLE_PT, PAQUETE_ANDROID, enlaceAppStore, enlacePlay } from '../i18n/strings';
import { texto } from '../lib/datos';
import CtaApp from '../components/CtaApp.astro';
import TiraEscaner from '../components/TiraEscaner.astro';
import '../styles/global.css';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  canonical: string;
  alternates: Record<Locale, string>;
  jsonld?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /** Qué tipo de página es, para los contadores: los eventos se agrupan por esto. */
  pagina?: 'ficha' | 'lista' | 'indice' | 'landing' | 'escaner' | 'guia' | 'blog' | 'otra';
}

const { locale, title, description, canonical, alternates, jsonld, noindex, pagina = 'otra' } = Astro.props;
// Los contadores de la web viven en una Cloud Function del proyecto de la app
// (backend/functions/web-eventos.js): vista, «llegó al botón» y clic, por
// idioma, tipo de página y botón. Sin identificadores ni cookies.
const EVENTOS_URL = 'https://europe-west1-fodmap-guide-app.cloudfunctions.net/webEvento';
const s = t(locale);
const site = Astro.site ?? new URL('https://fodmind.com');
const abs = (ruta: string) => new URL(ruta, site).toString();
const jsonldFinal = jsonld ? (Array.isArray(jsonld) ? jsonld : [jsonld]) : [];

/** Open Graph pide idioma_PAÍS, que no es el mismo formato que hreflang. */
const OG_LOCALE: Record<Locale, string> = {
  en: 'en_US',
  es: 'es_ES',
  fr: 'fr_FR',
  de: 'de_DE',
  it: 'it_IT',
  pt: 'pt_PT',
};

const nav = [
  { href: urlEscaner(locale), label: s.navEscaner },
  { href: urlAlimentos(locale), label: s.navAlimentos },
  { href: urlGuia(locale), label: s.navGuia },
  { href: urlBlog(locale), label: s.navBlog },
];
---

<!doctype html>
<html lang={LOCALE_TAG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={abs(canonical)} />
    {LOCALES.map((l) => <link rel="alternate" hreflang={LOCALE_TAG[l]} href={abs(alternates[l])} />)}
    <link rel="alternate" hreflang="x-default" href={abs(alternates[LOCALE_RAIZ])} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Fodmind" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={abs(canonical)} />
    <meta property="og:image" content={abs('/og.png')} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={OG_LOCALE[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs('/og.png')} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#faf7ef" />
    {jsonldFinal.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {/*
      LA BARRA NATIVA DE LA APP STORE, y conviene saber para qué NO sirve.

      Safari en iOS pinta arriba una barra con el icono de la app, su nota y un
      botón de instalar. Es lo más parecido que existe a «abrir la ficha lista
      para descargar», y no cuesta más que esta línea.

      Lo que NO hace: no aparece en el navegador integrado de otras apps
      —TikTok, Instagram y Facebook usan su propio WKWebView— ni en Chrome de
      iOS. Solo Safari y Safari View Controller, según respuesta de un ingeniero
      de Apple en sus foros. Así que esto sirve al tráfico del buscador, que
      aterriza en las 1.843 fichas, y NO al de las redes.

      Sin `app-argument`: la app no consta que lea URLs de entrada, y un
      argumento que se ignora es código muerto. Con `affiliate-data`: Safari
      pega esos parámetros a la URL de la tienda, y así la barra cuenta como
      campaña «web-banner» en vez de fundirse con el resto.

      OJO CON LOS COMENTARIOS AQUÍ. En Astro, `<!-- -->` se sirve y `{ / * * / }`
      no. Esta explicación en HTML engordaba cada página 1.133 bytes COMPRIMIDOS
      —un 30 % sobre 3.811— y se multiplicaba por 11.479 páginas.
    */}
    <meta name="apple-itunes-app" content={`app-id=${APP_ID}, affiliate-data=pt=${APPLE_PT}&ct=web-banner&mt=8`} />
    {/*
      EL SALTO A LA TIENDA. Los botones de descarga apuntan al ancla de la banda
      de la propia página; con JS y en un móvil van directos a su tienda, que es
      un toque menos para quien entra con el teléfono en la mano. Sin JS sigue
      funcionando el ancla, y por eso el href es ese y no la tienda.

      TRES COSAS QUE COSTARON UNA REVISIÓN:

      1. querySelectorAll, no querySelector. Con el singular solo se arreglaba
         el PRIMER botón del DOM —el de la cabecera— y el del hero seguía
         desplazando la página. Ojo al tocarlo: un NodeList vacío es truthy, así
         que un `if (!lista) return` aquí no protegería de nada.

      2. iPadOS manda cadena de agente de Macintosh desde la 13, así que /iPad/
         no casa en un iPad. Se mira también maxTouchPoints; la app soporta iPad.

      3. Va en el head y además escucha el clic. El botón de la cabecera está en
         los primeros 3.500 bytes y este script estaba al final del documento:
         entre medias hay una ventana en la que un toque se iba al ancla. El
         oyente en fase de captura la cierra pase lo que pase.

      Y no se toca `rel`: sin target="_blank", noopener no hace nada, y
      noreferrer borraría la cabecera Referer y con ella el informe de referentes
      web de App Store Connect, que es la única atribución gratis que hay.

      Cada botón lleva `data-ct` con su nombre (cabecera, hero, contextual,
      barra) y el script lo pega al final del enlace de campaña: así la tienda
      dice qué botón trajo cada descarga, no solo que vino de la web.

      Y EN EL MÓVIL NO SE ELIGE TIENDA. Las insignias de la banda y los enlaces
      del pie llevan `data-tienda="apple|play"`; en un iPhone se esconde la de
      Play y en un Android la de Apple. Solo en escritorio quedan las dos, que
      es el único sitio donde no se sabe qué teléfono lleva quien mira.

      `data-abrir` ES «ABRE LA APP SI LA TIENES». En Android es un intent con
      el esquema de la app (fodmind://escanear) y la tienda de reserva: Chrome
      abre la app si está instalada y si no va a Play, sin diálogos. En iOS no
      hay forma limpia sin dominios asociados (el esquema suelto enseña un
      «no se puede abrir la página» cuando no está), así que el botón va a la
      tienda y la barra nativa de Safari, que sí sabe si la app está, es la
      que dice «Abrir». Cuando la app lea enlaces (2.4), el mismo botón abre
      el escáner con un enlace universal.
    */}
    <script is:inline define:vars={{ IOS: enlaceAppStore('web-'), ANDROID: enlacePlay('web-'), PAQUETE: PAQUETE_ANDROID }}>
      (function () {
        var ua = navigator.userAgent || '';
        var esIOS = /iPad|iPhone|iPod/.test(ua)
          || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        var destino = esIOS ? IOS : /Android/.test(ua) ? ANDROID : null;
        if (!destino) return;
        var enlace = function (a) {
          var tienda = destino + (a.getAttribute('data-ct') || 'boton');
          if (!esIOS && a.hasAttribute('data-abrir')) {
            return 'intent://escanear#Intent;scheme=fodmind;package=' + PAQUETE
              + ';S.browser_fallback_url=' + encodeURIComponent(tienda) + ';end';
          }
          return tienda;
        };
        var mia = esIOS ? 'apple' : 'play';
        var pinta = function () {
          var l = document.querySelectorAll('[data-descarga]');
          for (var i = 0; i < l.length; i += 1) l[i].setAttribute('href', enlace(l[i]));
          var t = document.querySelectorAll('[data-tienda]');
          for (var j = 0; j < t.length; j += 1) t[j].hidden = t[j].getAttribute('data-tienda') !== mia;
        };
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('[data-descarga]');
          if (a) a.setAttribute('href', enlace(a));
        }, true);
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', pinta);
        else pinta();
      })();
    </script>
  </head>
  <body>
    <header class="cabecera">
      <div class="contenedor barra">
        <a class="logo" href={urlLanding(locale)}>
          <span aria-hidden="true">🌿</span> <span class="logo-marca">Fodmind</span>
        </a>
        <nav class="nav" aria-label="principal">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
        <a class="boton boton-primario" href="#descargar" data-descarga data-ct="cabecera">{s.ctaApp}</a>
      </div>
    </header>

    <main>
      <div class="contenedor">
        <slot />
        <CtaApp locale={locale} />
      </div>
    </main>

    <footer class="pie">
      <div class="contenedor pie-rejilla">
        <div class="pie-sobre">
          <p class="pie-marca">🌿 Fodmind</p>
          <p class="pie-nota">{s.footerDisclaimer}</p>
          <p class="pie-nota">{s.footerSources}</p>
        </div>
        <div>
          <p class="pie-titulo">{s.ctaApp}</p>
          <a href={enlaceAppStore('web-pie')} rel="noopener" data-tienda="apple" data-ct="pie">App Store</a>
          <a href={enlacePlay('web-pie')} rel="noopener" data-tienda="play" data-ct="pie">Google Play</a>
        </div>
        <div>
          <p class="pie-titulo">Legal</p>
          <a href={urlFuentes(locale)}>{texto('sourcesTitle', locale)}</a>
          <a href={urlLegal(locale, 'privacidad')}>{s.privacyTitle}</a>
          <a href={urlLegal(locale, 'terminos')}>{s.termsTitle}</a>
          <p class="pie-nota">© 2026 Fodmind</p>
        </div>
        <div>
          <p class="pie-titulo">{s.langSwitch}</p>
          <div class="pie-idiomas">
            {LOCALES.map((l) => (
              <a href={alternates[l]} hreflang={LOCALE_TAG[l]}>{l.toUpperCase()}</a>
            ))}
          </div>
        </div>
      </div>
    </footer>
    <TiraEscaner locale={locale} />
    <!--
      Medición de visitas. La política de privacidad ya decía «las visitas se
      miden de forma anónima y agregada con Cloudflare Web Analytics» y el
      script no estaba en ninguna página: la web afirmaba algo que no pasaba.
      Sin cookies y sin datos personales, así que no pide consentimiento.
    -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "52da165e457a405bb28a45a1a23fe3cb"}'
    ></script>
    {/*
      LOS TRES CONTADORES DE CADA BOTÓN: cuántos ven la página, cuántos llegan
      hasta cada botón (la mitad visible una vez) y cuántos lo pulsan. Las
      tiendas ya separan las descargas por campaña; esto mide el tramo anterior,
      que era ciego: con 300 visitas al mes desde Google y «Web Referrer: —» en
      App Store Connect no se sabía si nadie llegaba al botón o nadie lo pulsaba.
      Va por `fetch` con `keepalive` —sale aunque la página ya se esté yendo a
      la tienda— y en modo no-cors, que con un cuerpo de texto es una petición
      simple sin preflight. No por `sendBeacon`: medido el 21-sep en Chrome,
      `sendBeacon` devolvía true y la función no recibía nada; el mismo cuerpo
      por fetch llegaba. Con un navegador automatizado no se cuenta nada.
    */}
    <script is:inline define:vars={{ EV: EVENTOS_URL, L: locale, PG: pagina }}>
      (function () {
        if (navigator.webdriver || !(window.fetch || navigator.sendBeacon)) return;
        var manda = function (t, ct) {
          var cuerpo = 'v=1&l=' + L + '&pg=' + PG + '&t=' + t + '&ct=' + (ct || '-');
          try {
            if (window.fetch) fetch(EV, { method: 'POST', mode: 'no-cors', keepalive: true, body: cuerpo }).catch(function () {});
            else navigator.sendBeacon(EV, cuerpo);
          } catch (e) {}
        };
        var nombre = function (a) { return 'web-' + (a.getAttribute('data-ct') || 'boton'); };
        manda('vista');
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[data-ct]');
          if (a) manda('clic', nombre(a));
        }, true);
        if (!('IntersectionObserver' in window)) return;
        var vistos = {};
        var io = new IntersectionObserver(function (entradas) {
          for (var i = 0; i < entradas.length; i += 1) {
            if (!entradas[i].isIntersecting) continue;
            var ct = nombre(entradas[i].target);
            io.unobserve(entradas[i].target);
            if (vistos[ct]) continue;
            vistos[ct] = true;
            manda('visto', ct);
          }
        }, { threshold: 0.5 });
        var arranca = function () {
          var l = document.querySelectorAll('a[data-ct]');
          for (var j = 0; j < l.length; j += 1) io.observe(l[j]);
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', arranca);
        else arranca();
      })();
    </script>
  </body>
</html>
